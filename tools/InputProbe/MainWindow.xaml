<Window x:Class="AimOdometer.Tools.InputProbe.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AimOdometer InputProbe" Width="760" Height="520"
        Background="#0B0D10" Foreground="#E8EDF2" FontFamily="Segoe UI" FontSize="15"
        WindowStartupLocation="CenterScreen">
  <DockPanel Margin="24">
    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#8B95A3" Margin="0,0,0,16">
      Measures how much path the background tracker loses to Windows 11 input coalescing.
      1) Make sure the tracker is running. 2) Press Start. 3) Keep this window focused and move the mouse
      like in a game (circles, flicks) for 30-60 s. 4) Press Stop and copy the result.
    </TextBlock>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,16,0,0">
      <Button x:Name="StartButton" Content="Start" Width="120" Height="36" Click="OnStart" />
      <Button x:Name="StopButton" Content="Stop" Width="120" Height="36" Margin="12,0,0,0" Click="OnStop" IsEnabled="False" />
      <Button Content="Copy result" Width="140" Height="36" Margin="12,0,0,0" Click="OnCopy" />
    </StackPanel>
    <TextBox x:Name="Output" IsReadOnly="True" FontFamily="Consolas" FontSize="14" Background="#14171C"
             Foreground="#E8EDF2" BorderBrush="#2A2F38" Padding="12" TextWrapping="Wrap" />
  </DockPanel>
</Window>
