<Window x:Class="AimOdometer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AimOdometer"
        Width="960" Height="600" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/icon.ico"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI">
  <Grid>
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="16" Padding="40,32"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel HorizontalAlignment="Center">
        <Image Source="Assets/logo.png" Width="96" Height="96" Margin="0,0,0,16"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <TextBlock Text="AimOdometer" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock x:Name="VersionText" FontSize="14" Margin="0,4,0,20"
                   Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Ellipse x:Name="TrackerDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="TrackerStatusText" FontSize="16" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
