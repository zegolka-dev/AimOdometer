<Application x:Class="AimOdometer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:AimOdometer.App.ViewModels"
             xmlns:v="clr-namespace:AimOdometer.App.Views"
             xmlns:c="clr-namespace:AimOdometer.App.Controls"
             ThemeMode="Dark"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Palette.xaml" />
        <ResourceDictionary Source="Themes/Converters.xaml" />
        <ResourceDictionary Source="Themes/Controls.xaml" />
        <ResourceDictionary Source="Themes/Templates.xaml" />
      </ResourceDictionary.MergedDictionaries>


      <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><v:OverviewView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:GamesViewModel}"><v:GamesView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:StatisticsViewModel}"><v:StatisticsView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:AchievementsViewModel}"><v:AchievementsView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:GearViewModel}"><v:GearView /></DataTemplate>
      <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
