<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Typography -->
  <Style x:Key="PageTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style x:Key="PageSubtitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,0,0,12" />
  </Style>
  <Style x:Key="CardLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="HeroNumber" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
    <Setter Property="FontSize" Value="64" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>
  <Style x:Key="BigNumber" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>
  <Style x:Key="MediumNumber" TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
    <Setter Property="FontSize" Value="20" />
  </Style>
  <Style x:Key="Icon" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Motion: short, eased state changes (hover fades in fast and out slower; press shrinks a little) -->
  <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
  <BackEase x:Key="Settle" EasingMode="EaseOut" Amplitude="0.6" />
  <Storyboard x:Key="HoverIn">
    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
  </Storyboard>
  <Storyboard x:Key="HoverOut">
    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
  </Storyboard>
  <Storyboard x:Key="SelectIn">
    <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
  </Storyboard>
  <Storyboard x:Key="SelectOut">
    <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOut}" />
  </Storyboard>
  <Storyboard x:Key="PressIn">
    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}" />
    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08" EasingFunction="{StaticResource EaseOut}" />
  </Storyboard>
  <Storyboard x:Key="PressOut">
    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource Settle}" />
    <DoubleAnimation Storyboard.TargetName="Scale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource Settle}" />
  </Storyboard>
  <Storyboard x:Key="BarIn">
    <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource EaseOut}" />
    <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource Settle}" />
  </Storyboard>
  <Storyboard x:Key="BarOut">
    <DoubleAnimation Storyboard.TargetName="Selected" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" EasingFunction="{StaticResource EaseOut}" />
    <DoubleAnimation Storyboard.TargetName="BarScale" Storyboard.TargetProperty="ScaleY" To="0" Duration="0:0:0.12" EasingFunction="{StaticResource EaseOut}" />
  </Storyboard>

  <!-- Keyboard focus ring: WPF shows FocusVisualStyle only for keyboard focus, never after a mouse click -->
  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="{StaticResource AccentTextBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FocusRingPill">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="-3" CornerRadius="19" BorderThickness="2" BorderBrush="{StaticResource AccentTextBrush}" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Date pickers: the inner text box is what a screen reader focuses; give it the picker's name. -->
  <Style TargetType="DatePickerTextBox" BasedOn="{StaticResource {x:Type DatePickerTextBox}}">
    <Setter Property="AutomationProperties.Name"
            Value="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource AncestorType=DatePicker}}" />
  </Style>

  <!-- Surfaces -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="20,16" />
  </Style>
  <Style x:Key="AccentCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
  </Style>

  <!-- Left navigation item -->
  <Style x:Key="NavItem" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,2" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root" Background="Transparent" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Scale" /></Border.RenderTransform>
            <Grid>
              <Border x:Name="Hover" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="10" Opacity="0" />
              <Border x:Name="Selected" Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Opacity="0" />
              <Border Width="3" CornerRadius="2" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                      Margin="0,10" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="BarScale" ScaleY="0" /></Border.RenderTransform>
              </Border>
              <StackPanel Orientation="Horizontal" Margin="12,10">
                <TextBlock Style="{StaticResource Icon}" Text="{TemplateBinding Tag}" Margin="0,0,12,0" />
                <ContentPresenter VerticalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource BarIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource BarOut}" /></Trigger.ExitActions>
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented choice (period pickers) -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingPill}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="16" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Scale" /></Border.RenderTransform>
            <Grid>
              <Border x:Name="Hover" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="15" Opacity="0" />
              <Border x:Name="Selected" Background="{StaticResource AccentSoftBrush}" CornerRadius="15" Opacity="0" />
              <ContentPresenter HorizontalAlignment="Center" Margin="14,6" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource SelectIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource SelectOut}" /></Trigger.ExitActions>
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Buttons -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{StaticResource PrimaryButtonBrush}" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Scale" /></Border.RenderTransform>
            <Grid>
              <Border x:Name="Hover" Background="#1AFFFFFF" CornerRadius="9" Opacity="0" />
              <ContentPresenter HorizontalAlignment="Center" Margin="18,9" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SecondaryButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Scale" /></Border.RenderTransform>
            <Grid>
              <Border x:Name="Hover" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="9" Opacity="0" />
              <ContentPresenter HorizontalAlignment="Center" Margin="16,8" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="Transparent" Padding="2">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- "Support the author": quiet muted text that lights up violet to pink on hover or keyboard focus, a shine runs
       through the letters and the heart beats once. With animations off in Windows only the colour fades. -->
  <LinearGradientBrush x:Key="SupportGlowBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#C4B5FD" Offset="0" />
    <GradientStop Color="#F0ABFC" Offset="0.55" />
    <GradientStop Color="#FB7185" Offset="1" />
  </LinearGradientBrush>
  <Style x:Key="SupportLink" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ControlTemplate.Resources>
            <Storyboard x:Key="LightUp">
              <DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="Dim" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="HeartFill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3" EasingFunction="{StaticResource EaseOut}" />
            </Storyboard>
            <Storyboard x:Key="Fade">
              <DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="Dim" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="HeartFill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.35" EasingFunction="{StaticResource EaseOut}" />
            </Storyboard>
            <Storyboard x:Key="Shine">
              <DoubleAnimation Storyboard.TargetName="Sweep" Storyboard.TargetProperty="X" From="-1" To="1" BeginTime="0:0:0.06" Duration="0:0:0.75" EasingFunction="{StaticResource EaseOut}" />
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Beat" Storyboard.TargetProperty="ScaleX">
                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="1.25" EasingFunction="{StaticResource EaseOut}" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1" EasingFunction="{StaticResource Settle}" />
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Beat" Storyboard.TargetProperty="ScaleY">
                <EasingDoubleKeyFrame KeyTime="0:0:0.14" Value="1.25" EasingFunction="{StaticResource EaseOut}" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.42" Value="1" EasingFunction="{StaticResource Settle}" />
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </ControlTemplate.Resources>
          <Border x:Name="Root" Background="Transparent" Padding="2" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
              <Grid Margin="0,0,8,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform><ScaleTransform x:Name="Beat" /></Grid.RenderTransform>
                <TextBlock Style="{StaticResource Icon}" Text="&#xEB51;" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock x:Name="HeartFill" Style="{StaticResource Icon}" Text="&#xEB52;" Foreground="#FB7185" Opacity="0">
                  <TextBlock.Effect>
                    <DropShadowEffect x:Name="Glow" Color="#F43F5E" BlurRadius="12" ShadowDepth="0" Opacity="0" />
                  </TextBlock.Effect>
                </TextBlock>
              </Grid>
              <Grid>
                <TextBlock x:Name="Dim" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource TextMutedBrush}" />
                <TextBlock x:Name="Lit" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource SupportGlowBrush}" Opacity="0" />
                <!-- The shine: white letters seen only through a narrow band that slides from left to right -->
                <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" Foreground="White" IsHitTestVisible="False">
                  <TextBlock.OpacityMask>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                      <LinearGradientBrush.RelativeTransform><TranslateTransform x:Name="Sweep" X="-1" /></LinearGradientBrush.RelativeTransform>
                      <GradientStop Color="#00FFFFFF" Offset="0.3" />
                      <GradientStop Color="#CCFFFFFF" Offset="0.5" />
                      <GradientStop Color="#00FFFFFF" Offset="0.7" />
                    </LinearGradientBrush>
                  </TextBlock.OpacityMask>
                </TextBlock>
              </Grid>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource LightUp}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Fade}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentSoftBrush}" />
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource LightUp}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource Fade}" /></Trigger.ExitActions>
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
              </MultiDataTrigger.Conditions>
              <MultiDataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource Shine}" /></MultiDataTrigger.EnterActions>
            </MultiDataTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A payment service in the support window: a card that lifts its border on hover -->
  <Style x:Key="SupportOption" TargetType="Button">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                  CornerRadius="12" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Scale" /></Border.RenderTransform>
            <Grid>
              <Border x:Name="Hover" Background="{StaticResource SurfaceHoverBrush}" CornerRadius="11" Opacity="0" />
              <ContentPresenter Margin="14,12" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource HoverIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource HoverOut}" /></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard Storyboard="{StaticResource PressIn}" /></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard Storyboard="{StaticResource PressOut}" /></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- "Recommended": a small accent pill next to a setting most people should keep on -->
  <Style x:Key="RecommendedTag" TargetType="Border">
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="8,1,8,2" />
    <Setter Property="Margin" Value="10,0,0,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <!-- Thin horizontal bar used for shares and progress -->
  <Style x:Key="ShareBar" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="3" />
            <Border x:Name="PART_Track" />
            <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"
                    RenderTransformOrigin="0,0.5">
              <Border.RenderTransform><ScaleTransform x:Name="Fill" ScaleX="0" /></Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <!-- Fills from the left when the page appears. -->
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation Storyboard.TargetName="Fill" Storyboard.TargetProperty="ScaleX" From="0" To="1" BeginTime="0:0:0.08"
                                   Duration="0:0:0.5" EasingFunction="{StaticResource EaseOut}" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
