<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Palette C "Neon Violet" (docs/PLAN.md, section 8). Components use the brushes, never raw colors. -->
  <Color x:Key="BackgroundColor">#0F0F23</Color>
  <Color x:Key="SurfaceColor">#1A1830</Color>
  <Color x:Key="SurfaceElevatedColor">#24223D</Color>
  <Color x:Key="SurfaceHoverColor">#2C2948</Color>
  <Color x:Key="BorderColor">#2E2B4A</Color>
  <Color x:Key="BorderStrongColor">#3B2A6B</Color>
  <Color x:Key="TextPrimaryColor">#E2E8F0</Color>
  <Color x:Key="TextSecondaryColor">#94A3B8</Color>
  <Color x:Key="TextMutedColor">#7C86A2</Color>
  <Color x:Key="AccentColor">#8B5CF6</Color>
  <!-- Lighter violet for accent TEXT: #8B5CF6 on the background is below 4.5:1 contrast. -->
  <Color x:Key="AccentTextColor">#B9A4FC</Color>
  <Color x:Key="Accent2Color">#F43F5E</Color>
  <Color x:Key="SuccessColor">#4ADE80</Color>
  <Color x:Key="WarningColor">#FBBF24</Color>
  <Color x:Key="DangerColor">#F87171</Color>

  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
  <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentColor}" Opacity="0.18" />
  <SolidColorBrush x:Key="BarBrush" Color="#5A43A8" />
  <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerColor}" Opacity="0.16" />

  <!-- Leaderboard titles: the creator wears the app's violet (with a glow in the view), beta testers sky blue. -->
  <LinearGradientBrush x:Key="CreatorTagBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#7C3AED" Offset="0" />
    <GradientStop Color="#A78BFA" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="CreatorTagBorderBrush" Color="#C4B5FD" />
  <SolidColorBrush x:Key="BetaTagBrush" Color="#38BDF8" />
  <SolidColorBrush x:Key="BetaTagSoftBrush" Color="#38BDF8" Opacity="0.14" />

  <!-- Categorical chart series, in order. -->
  <Color x:Key="Series1Color">#8B5CF6</Color>
  <Color x:Key="Series2Color">#F43F5E</Color>
  <Color x:Key="Series3Color">#22D3EE</Color>
  <Color x:Key="Series4Color">#FBBF24</Color>
  <Color x:Key="Series5Color">#4ADE80</Color>
  <Color x:Key="Series6Color">#F472B6</Color>
  <Color x:Key="SeriesOtherColor">#4B4868</Color>

  <!-- Fluent theme accent overrides (Windows 11 controls pick these up). -->
  <Color x:Key="SystemAccentColor">#8B5CF6</Color>
  <Color x:Key="SystemAccentColorLight1">#9D74F7</Color>
  <Color x:Key="SystemAccentColorLight2">#B9A4FC</Color>
  <Color x:Key="SystemAccentColorLight3">#D4C6FD</Color>
  <Color x:Key="SystemAccentColorDark1">#7443E8</Color>
  <Color x:Key="SystemAccentColorDark2">#5B2FC9</Color>
  <Color x:Key="SystemAccentColorDark3">#4422A0</Color>

  <FontFamily x:Key="NumberFont">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
  <FontFamily x:Key="TextFont">Segoe UI Variable Text, Segoe UI</FontFamily>
  <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
