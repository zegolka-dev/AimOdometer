<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AimOdometer.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <!-- Precompiled code for faster first frame (target: < 1.5 s). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <SelfContained>false</SelfContained>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\icon.ico" Link="Assets\icon.ico" />
    <Resource Include="..\..\assets\logo-512.png" Link="Assets\logo.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AimOdometer.Core\AimOdometer.Core.csproj" />
    <ProjectReference Include="..\AimOdometer.Win32\AimOdometer.Win32.csproj" />
  </ItemGroup>
</Project>
