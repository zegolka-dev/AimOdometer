<UserControl x:Class="AimOdometer.App.Views.WhatsNewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AimOdometer.App.Localization">
  <Border Style="{StaticResource AccentCard}" Width="560" MaxHeight="560" VerticalAlignment="Center" HorizontalAlignment="Center"
          Padding="28,24" Background="{StaticResource SurfaceBrush}">
    <DockPanel>
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE735;" FontSize="22" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" FontSize="22" TextWrapping="Wrap" />
      </StackPanel>
      <Button DockPanel.Dock="Bottom" Style="{StaticResource PrimaryButton}" Content="{l:T WhatsNew.Ok}" Command="{Binding CloseCommand}"
              HorizontalAlignment="Right" Margin="0,18,0,0" AutomationProperties.AutomationId="WhatsNewOk" />
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Releases}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,14">
                <TextBlock Style="{StaticResource CardLabel}" Text="{Binding Title}" Margin="0,0,0,6" />
                <ItemsControl ItemsSource="{Binding Items}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <DockPanel Margin="0,0,0,8">
                        <Ellipse DockPanel.Dock="Left" Width="6" Height="6" Fill="{StaticResource AccentTextBrush}" Margin="0,8,12,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="14" LineHeight="20" />
                      </DockPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
