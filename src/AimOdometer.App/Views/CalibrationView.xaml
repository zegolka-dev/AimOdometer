<UserControl x:Class="AimOdometer.App.Views.CalibrationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AimOdometer.App.Localization"
             xmlns:vm="clr-namespace:AimOdometer.App.ViewModels">
  <Border Style="{StaticResource AccentCard}" Width="680" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="32,28"
          Background="{StaticResource SurfaceBrush}">
    <StackPanel>
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Calibration.Title}" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{Binding Device.Name}" Margin="0,0,0,16" />

      <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Calibration.Reference}" Margin="0,0,0,6" />
      <ComboBox ItemsSource="{x:Static vm:CalibrationViewModel.References}" SelectedItem="{Binding Reference}" DisplayMemberPath="Name"
                Width="320" HorizontalAlignment="Left" Margin="0,0,0,16" AutomationProperties.Name="{l:T Calibration.Reference}" />

      <!-- Measuring pad: the left button is held inside this area -->
      <Border Background="{StaticResource SurfaceElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
              CornerRadius="12" Padding="20,18" MinHeight="150" Cursor="Cross">
        <StackPanel>
          <TextBlock Text="{Binding Instruction}" FontSize="15" TextWrapping="Wrap" />
          <TextBlock Text="{Binding LiveCounts}" FontFamily="{StaticResource NumberFont}" FontSize="22" Foreground="{StaticResource AccentTextBrush}" Margin="0,12,0,0" />
          <ItemsControl ItemsSource="{Binding Samples}" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" /></DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <TextBlock Text="{Binding Result}" FontSize="15" TextWrapping="Wrap" Margin="0,16,0,0"
                 Visibility="{Binding Result, Converter={StaticResource NullToCollapsed}}" />
      <TextBlock Style="{StaticResource Hint}" Text="{l:T Calibration.Tips}" FontSize="13" Margin="0,12,0,0" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button Style="{StaticResource LinkButton}" Content="{l:T Common.Cancel}" Command="{Binding CancelCommand}" VerticalAlignment="Center" Margin="0,0,16,0" />
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T Calibration.Restart}" Command="{Binding RestartCommand}" Margin="0,0,8,0" />
        <Button Style="{StaticResource PrimaryButton}" Content="{l:T Calibration.Apply}" Command="{Binding ApplyCommand}"
                IsEnabled="{Binding IsDone}" />
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
