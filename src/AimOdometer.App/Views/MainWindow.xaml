<Window x:Class="AimOdometer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:AimOdometer.App.Localization"
        xmlns:v="clr-namespace:AimOdometer.App.Views"
        xmlns:c="clr-namespace:AimOdometer.App.Controls"
        Title="AimOdometer"
        Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/icon.ico"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource TextFont}"
        UseLayoutRounding="True">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
      <DockPanel Margin="16,20,16,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,24">
          <Image Source="/Assets/logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Text="AimOdometer" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Updates and complaints: links under the status, with room to the window edge -->
        <StackPanel DockPanel.Dock="Bottom" Margin="4,0,0,6">
          <Button AutomationProperties.Name="{l:T Update.CheckNow}" Style="{StaticResource LinkButton}" Command="{Binding CheckUpdatesCommand}" HorizontalAlignment="Left"
                  AutomationProperties.AutomationId="SidebarCheckUpdates">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="{l:T Update.CheckNow}" />
            </StackPanel>
          </Button>
          <TextBlock Text="{Binding Updates.LastResult}" Style="{StaticResource Hint}" FontSize="12" TextWrapping="Wrap" Margin="24,2,0,0"
                     Visibility="{Binding Updates.LastResult, Converter={StaticResource NullToCollapsed}}" />
          <Button AutomationProperties.Name="{l:T Feedback.Button}" Style="{StaticResource LinkButton}" Command="{Binding OpenFeedbackCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                  AutomationProperties.AutomationId="OpenFeedback">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xED15;" Margin="0,0,8,0" VerticalAlignment="Center" />
              <TextBlock Text="{l:T Feedback.Button}" />
            </StackPanel>
          </Button>
          <Button Content="{l:T Support.Button}" Style="{StaticResource SupportLink}" Command="{Binding OpenSupportCommand}" HorizontalAlignment="Left" Margin="0,10,0,0"
                  AutomationProperties.Name="{l:T Support.Button}" AutomationProperties.AutomationId="OpenSupport"
                  Visibility="{Binding CanSupport, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Live tracker status -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="10" Padding="12,10" Margin="0,12,0,14">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,10,0" VerticalAlignment="Center">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Tracking"><Setter Property="Fill" Value="{StaticResource SuccessBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Paused"><Setter Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Stopped"><Setter Property="Fill" Value="{StaticResource DangerBrush}" /></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Text="{Binding StatusText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" MaxWidth="160" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Pages}" KeyboardNavigation.TabNavigation="Cycle">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <RadioButton Style="{StaticResource NavItem}" GroupName="Nav" Tag="{Binding Icon}"
                           IsChecked="{Binding IsCurrent}"
                           AutomationProperties.Name="{Binding Title}"
                           AutomationProperties.AutomationId="{Binding TitleKey}"
                           Content="{Binding Title}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- Page -->
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" Focusable="False">
      <ScrollViewer.Style>
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
          <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
          <Style.Triggers>
            <!-- The map page fills the window: its height is the viewport, the map scrolls inside itself. -->
            <DataTrigger Binding="{Binding CurrentPage.FillsViewport}" Value="True">
              <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </ScrollViewer.Style>
      <ContentControl x:Name="PageHost" Content="{Binding CurrentPage}" Margin="36,28,36,32" Focusable="False">
        <ContentControl.RenderTransform>
          <TranslateTransform />
        </ContentControl.RenderTransform>
      </ContentControl>
    </ScrollViewer>

    <!-- Update in progress -->
    <Border Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,12,0,0" Padding="16,8"
            CornerRadius="10" Background="{StaticResource AccentBrush}" Panel.ZIndex="5"
            Visibility="{Binding Updates.Banner, Converter={StaticResource NullToCollapsed}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White" />
        <TextBlock Text="{Binding Updates.Banner}" Foreground="White" FontSize="13" FontWeight="SemiBold" />
      </StackPanel>
    </Border>

    <!-- Overlays -->
    <Grid Grid.ColumnSpan="2" Background="#CC07071A" c:Motion.Appear="Fade" Visibility="{Binding HasOverlay, Converter={StaticResource BoolToVisibility}}">
      <v:OnboardingView c:Motion.Appear="Pop" DataContext="{Binding Onboarding}" Visibility="{Binding DataContext.IsOnboardingVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
      <v:FeedbackView c:Motion.Appear="Pop" DataContext="{Binding Feedback}" Visibility="{Binding DataContext.IsFeedbackVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
      <v:SupportView c:Motion.Appear="Pop" DataContext="{Binding Support}" Visibility="{Binding DataContext.IsSupportVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
      <v:WhatsNewView c:Motion.Appear="Pop" DataContext="{Binding WhatsNew}" Visibility="{Binding DataContext.IsWhatsNewVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
      <v:ShareView c:Motion.Appear="Pop" DataContext="{Binding Share}" Visibility="{Binding DataContext.IsShareVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
      <v:CalibrationView c:Motion.Appear="Pop" DataContext="{Binding Calibration}" Visibility="{Binding DataContext.IsCalibrationVisible, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
  </Grid>
</Window>
