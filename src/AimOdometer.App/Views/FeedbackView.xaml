<UserControl x:Class="AimOdometer.App.Views.FeedbackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AimOdometer.App.Localization">
  <Border Style="{StaticResource AccentCard}" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="28,24"
          Background="{StaticResource SurfaceBrush}">
    <Grid>
      <!-- Writing -->
      <StackPanel Visibility="{Binding IsSent, Converter={StaticResource InverseBoolToVisibility}}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Feedback.Title}" FontSize="24" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Feedback.Subtitle}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,16" />

        <WrapPanel Margin="0,0,0,12">
          <RadioButton Style="{StaticResource Segment}" GroupName="FeedbackKind" Content="{l:T Feedback.Bug}" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Bug}" />
          <RadioButton Style="{StaticResource Segment}" GroupName="FeedbackKind" Content="{l:T Feedback.Idea}" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Idea}" />
          <RadioButton Style="{StaticResource Segment}" GroupName="FeedbackKind" Content="{l:T Feedback.Other}" IsChecked="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Other}" />
        </WrapPanel>

        <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Feedback.MessageLabel}" Margin="0,0,0,6" />
        <TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                 Height="150" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{l:T Feedback.MessageLabel}"
                 AutomationProperties.AutomationId="FeedbackMessage" />

        <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Feedback.ContactLabel}" Margin="0,14,0,6" />
        <TextBox Text="{Binding Contact, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" AutomationProperties.Name="{l:T Feedback.ContactLabel}" />
        <TextBlock Style="{StaticResource Hint}" Text="{l:T Feedback.ContactHint}" TextWrapping="Wrap" Margin="0,4,0,0" />

        <CheckBox IsChecked="{Binding IncludeDetails}" Margin="0,14,0,0">
          <TextBlock TextWrapping="Wrap">
            <Run Text="{l:T Feedback.IncludeDetails}" /><Run Text=" " /><Run Text="{Binding Details, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}" />
          </TextBlock>
        </CheckBox>
        <TextBlock Style="{StaticResource Hint}" Text="{l:T Feedback.SignedInNote}" TextWrapping="Wrap" Margin="28,4,0,0"
                   Visibility="{Binding SignedIn, Converter={StaticResource BoolToVisibility}}" />

        <TextBlock Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding Problem, Converter={StaticResource NullToCollapsed}}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
          <Button Style="{StaticResource SecondaryButton}" Content="{l:T Common.Cancel}" Command="{Binding CloseCommand}" Margin="0,0,8,0" />
          <Button Style="{StaticResource PrimaryButton}" Content="{l:T Feedback.Send}" Command="{Binding SendCommand}" AutomationProperties.AutomationId="FeedbackSend" />
        </StackPanel>
      </StackPanel>

      <!-- Sent -->
      <StackPanel Visibility="{Binding IsSent, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Feedback.ThanksTitle}" FontSize="24" />
        <TextBlock Text="{l:T Feedback.ThanksText}" TextWrapping="Wrap" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,18" />
        <Button Style="{StaticResource PrimaryButton}" Content="{l:T WhatsNew.Ok}" Command="{Binding CloseCommand}" HorizontalAlignment="Right" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
