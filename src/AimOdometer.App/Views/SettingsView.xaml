<UserControl x:Class="AimOdometer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AimOdometer.App.Localization">
  <StackPanel MaxWidth="900" HorizontalAlignment="Left">
    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Title}" />
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Settings.Subtitle}" Margin="0,0,0,20" />

    <!-- Steam account and cloud -->
    <Border Style="{StaticResource AccentCard}" Margin="0,0,0,12" DataContext="{Binding Account}">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Cloud.Title}" />

        <!-- Signed out -->
        <StackPanel Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:T Cloud.Pitch}" TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="{StaticResource TextSecondaryBrush}" />
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding SignInCommand}" HorizontalAlignment="Left" Margin="0,16,0,0"
                  AutomationProperties.AutomationId="CloudSignIn">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Icon}" Text="&#xE77B;" Margin="0,0,8,0" />
              <TextBlock Text="{l:T Cloud.SignIn}" />
            </StackPanel>
          </Button>
          <TextBlock Style="{StaticResource Hint}" Text="{l:T Cloud.PrivacyHint}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>

        <!-- Waiting for the browser -->
        <StackPanel Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{l:T Cloud.ContinueInBrowser}" TextWrapping="Wrap" FontSize="14" />
          <Button Style="{StaticResource SecondaryButton}" Content="{l:T Common.Cancel}" Command="{Binding CancelSignInCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Signed in -->
        <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Orientation="Horizontal">
            <Border Width="56" Height="56" CornerRadius="12" ClipToBounds="True" Background="{StaticResource SurfaceElevatedBrush}" Margin="0,0,14,0">
              <Image Source="{Binding Avatar}" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding PersonaName}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SyncText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
          </StackPanel>

          <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Cloud.AllPcs}" Margin="0,18,0,6" />
          <UniformGrid Columns="3" Margin="-6,0">
            <StackPanel Margin="6,0">
              <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Common.Today}" />
              <TextBlock Style="{StaticResource MediumNumber}" Text="{Binding TodayAll, TargetNullValue='-'}" />
            </StackPanel>
            <StackPanel Margin="6,0">
              <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Common.ThisWeek}" />
              <TextBlock Style="{StaticResource MediumNumber}" Text="{Binding WeekAll, TargetNullValue='-'}" />
            </StackPanel>
            <StackPanel Margin="6,0">
              <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Common.AllTime}" />
              <TextBlock Style="{StaticResource MediumNumber}" Text="{Binding AllTimeAll, TargetNullValue='-'}" />
            </StackPanel>
          </UniformGrid>

          <ItemsControl ItemsSource="{Binding Pcs}" Margin="0,14,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,0,0,6">
                  <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding Details}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Cloud.Privacy}" Margin="0,14,0,6" />
          <CheckBox IsChecked="{Binding ShareWithFriends}" Content="{l:T Cloud.ShareWithFriends}" />
          <CheckBox IsChecked="{Binding ShowInWorld}" Content="{l:T Cloud.ShowInWorld}" Margin="0,8,0,0" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:T Cloud.PrivacyHint2}" TextWrapping="Wrap" Margin="28,4,0,0" />

          <WrapPanel Margin="0,12,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{l:T Cloud.SyncNow}" Command="{Binding SyncNowCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource SecondaryButton}" Content="{l:T Cloud.SignOut}" Command="{Binding SignOutCommand}" Margin="0,0,8,0" />
            <Button Style="{StaticResource LinkButton}" Content="{l:T Cloud.DeleteAccount}" Command="{Binding DeleteAccountCommand}" Foreground="{StaticResource DangerBrush}" />
          </WrapPanel>
          <TextBlock Style="{StaticResource Hint}" Text="{l:T Cloud.SyncHint}" TextWrapping="Wrap" Margin="0,10,0,0" />
        </StackPanel>

        <TextBlock Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"
                   Visibility="{Binding Problem, Converter={StaticResource NullToCollapsed}}" />
      </StackPanel>
    </Border>


    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.LanguageAndUnits}" />
        <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Settings.Language}" Margin="0,0,0,6" />
        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="260" HorizontalAlignment="Left"
                  AutomationProperties.Name="{l:T Settings.Language}">
          <ComboBox.ItemTemplate>
            <DataTemplate><TextBlock Text="{Binding Converter={StaticResource LanguageLabel}}" /></DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Settings.Units}" Margin="0,16,0,6" />
        <StackPanel Orientation="Horizontal">
          <RadioButton Style="{StaticResource Segment}" GroupName="Units" Content="{l:T Settings.Metric}" IsChecked="{Binding Metric}" />
          <RadioButton Style="{StaticResource Segment}" GroupName="Units" Content="{l:T Settings.Imperial}" IsChecked="{Binding Metric, Converter={StaticResource InverseBool}}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Mouse}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Settings.MouseHint}" FontSize="13" Margin="0,0,0,12" />
        <TextBlock Text="{Binding Mice.Saved}" Foreground="{StaticResource SuccessBrush}" FontSize="13" Margin="0,0,0,10"
                   Visibility="{Binding Mice.Saved, Converter={StaticResource NullToCollapsed}}" />
        <ItemsControl ItemsSource="{Binding Mice.Devices}" ItemTemplate="{StaticResource DeviceRowTemplate}" />
        <TextBlock Style="{StaticResource Hint}" Text="{l:T Gear.DpiButtonWarning}" FontSize="12" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Startup}" />
        <CheckBox IsChecked="{Binding Autostart}" Content="{l:T Settings.Autostart}" Margin="0,0,0,10" />
        <CheckBox IsChecked="{Binding ShowTrayIcon}" Content="{l:T Settings.ShowTrayIcon}" />
        <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.ShowTrayIconHint}" Margin="28,4,0,0" />
        <CheckBox IsChecked="{Binding CountElevatedGames}" Content="{l:T Settings.Elevated}" Margin="0,10,0,0" />
        <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.ElevatedHint}" Margin="28,4,0,0" TextWrapping="Wrap" />
        <TextBlock Text="{Binding ElevatedMessage}" FontSize="13" Foreground="{StaticResource AccentTextBrush}" Margin="28,4,0,0" TextWrapping="Wrap"
                   Visibility="{Binding ElevatedMessage, Converter={StaticResource NullToCollapsed}}" />
        <CheckBox IsChecked="{Binding Notifications}" Content="{l:T Settings.Notifications}" Margin="0,10,0,0" />
        <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.NotificationsHint}" Margin="28,4,0,0" TextWrapping="Wrap" />
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T Settings.NotificationTest}" Command="{Binding TestNotificationCommand}"
                HorizontalAlignment="Left" Margin="28,8,0,0" />
        <TextBlock Text="{Binding NotificationTestMessage}" FontSize="13" Foreground="{StaticResource AccentTextBrush}" Margin="28,6,0,0" TextWrapping="Wrap"
                   Visibility="{Binding NotificationTestMessage, Converter={StaticResource NullToCollapsed}}" />
        <CheckBox IsChecked="{Binding AutoUpdate}" Content="{l:T Settings.AutoUpdate}" Margin="0,10,0,0" />
        <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.AutoUpdateHint}" Margin="28,4,0,0" TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Data}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Settings.DataHint}" FontSize="13" Margin="0,0,0,12" />
        <Button Style="{StaticResource SecondaryButton}" Content="{l:T Settings.OpenDataFolder}" Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" />
        <WrapPanel Margin="0,10,0,0">
          <Button Style="{StaticResource SecondaryButton}" Content="{l:T Settings.ExportCsv}" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
          <Button Style="{StaticResource LinkButton}" Content="{l:T Settings.DeleteLocal}" Command="{Binding DeleteLocalDataCommand}" Foreground="{StaticResource DangerBrush}" />
        </WrapPanel>
        <TextBlock Text="{Binding DataMessage}" FontSize="13" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Visibility="{Binding DataMessage, Converter={StaticResource NullToCollapsed}}" />
      </StackPanel>
    </Border>

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.About}" />
        <TextBlock FontSize="13" Foreground="{StaticResource TextSecondaryBrush}">
          <Run Text="AimOdometer" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneWay}" />
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button Style="{StaticResource SecondaryButton}" Content="{l:T Update.CheckNow}" Command="{Binding CheckUpdatesCommand}"
                  AutomationProperties.AutomationId="CheckUpdates" />
          <TextBlock Text="{Binding Updates.LastResult}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                     Margin="12,0,0,0" TextWrapping="Wrap" Visibility="{Binding Updates.LastResult, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Hint}" Text="{Binding StartupTime}" Margin="0,4,0,0" />
        <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.Privacy}" Margin="0,8,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
