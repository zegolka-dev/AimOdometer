<UserControl x:Class="AimOdometer.App.Views.GearView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AimOdometer.App.Localization">
  <StackPanel>
    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Gear.Title}" />
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Gear.Subtitle}" Margin="0,0,0,16" />

    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="16,12" Margin="0,0,0,16">
      <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,12,0" VerticalAlignment="Top" />
        <TextBlock Text="{l:T Gear.DpiButtonWarning}" TextWrapping="Wrap" FontSize="13" MaxWidth="760" />
      </StackPanel>
    </Border>

    <TextBlock Text="{Binding Saved}" Foreground="{StaticResource SuccessBrush}" FontSize="13" Margin="0,0,0,10"
               Visibility="{Binding Saved, Converter={StaticResource NullToCollapsed}}" />

    <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource DeviceRowTemplate}" />

    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Gear.WearTitle}" Margin="0,16,0,4" />
    <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Gear.WearSubtitle}" FontSize="13" Margin="0,0,0,12" />

    <ItemsControl ItemsSource="{Binding Gear.Items}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,0,10" Padding="16,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Width="44" Height="44" CornerRadius="10" Background="{StaticResource SurfaceElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                <Path Data="{Binding Icon}" Width="24" Height="24" Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{StaticResource AccentTextBrush}" StrokeThickness="1.35" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                  <Path.LayoutTransform>
                    <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                  </Path.LayoutTransform>
                </Path>
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock FontSize="15">
                  <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding KindText, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" />
                </TextBlock>
                <TextBlock Style="{StaticResource Hint}" Text="{Binding Details}" Margin="0,2,0,8" />
                <ProgressBar x:Name="Bar" Style="{StaticResource ShareBar}" Height="8" Value="{Binding Fraction, Mode=OneWay}" />
                <DockPanel Margin="0,6,0,0">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding RetiredText}" Style="{StaticResource Hint}" />
                  <TextBlock Text="{Binding UsedText}" FontSize="13" FontFamily="{StaticResource NumberFont}" />
                </DockPanel>
                <TextBlock Text="{l:T Gear.ReplaceSoon}" Foreground="{StaticResource WarningBrush}" FontSize="13" Margin="0,6,0,0"
                           Visibility="{Binding TimeToReplace, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="{l:T Gear.Retire}" Command="{Binding RetireCommand}" Margin="0,0,8,0"
                        Visibility="{Binding IsRetired, Converter={StaticResource InverseBoolToVisibility}}" />
                <Button Style="{StaticResource SecondaryButton}" Content="{l:T Gear.Delete}" Command="{Binding DeleteCommand}" />
              </StackPanel>
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding TimeToReplace}" Value="True">
              <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsRetired}" Value="True">
              <Setter TargetName="Card" Property="Opacity" Value="0.6" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Style="{StaticResource Hint}" Text="{l:T Gear.NoGear}" FontSize="13" Margin="0,0,0,10"
               Visibility="{Binding Gear.HasItems, Converter={StaticResource InverseBoolToVisibility}}" />

    <!-- Add form -->
    <Border Style="{StaticResource Card}" Padding="16,14">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Gear.Add}" Margin="0,0,0,10" />
        <WrapPanel>
          <StackPanel Margin="0,0,12,8">
            <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Gear.KindLabel}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Gear.Kinds}" SelectedItem="{Binding Gear.NewKind}" DisplayMemberPath="Name" Width="170"
                      AutomationProperties.Name="{l:T Gear.KindLabel}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,8">
            <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Gear.Name}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Gear.NewName, UpdateSourceTrigger=PropertyChanged}" Width="220" AutomationProperties.Name="{l:T Gear.Name}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,8" Visibility="{Binding Gear.NeedsMouse, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Gear.ForMouse}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Gear.Mice}" SelectedItem="{Binding Gear.NewMouse}" DisplayMemberPath="Name" Width="200"
                      AutomationProperties.Name="{l:T Gear.ForMouse}" />
          </StackPanel>
          <StackPanel Margin="0,0,12,8">
            <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Gear.StartedOn}" Margin="0,0,0,4" />
            <DatePicker SelectedDate="{Binding Gear.NewStarted}" Width="150" />
          </StackPanel>
          <StackPanel Margin="0,0,12,8">
            <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Gear.LifetimeKm}" Margin="0,0,0,4" />
            <TextBox Text="{Binding Gear.NewLifetime, UpdateSourceTrigger=PropertyChanged}" Width="100" AutomationProperties.Name="{l:T Gear.LifetimeKm}" />
          </StackPanel>
          <Button Style="{StaticResource PrimaryButton}" Content="{l:T Gear.AddButton}" Command="{Binding Gear.AddCommand}" VerticalAlignment="Bottom" Margin="0,0,0,8" />
        </WrapPanel>
        <TextBlock Text="{Binding Gear.Error}" Foreground="{StaticResource DangerBrush}" FontSize="13"
                   Visibility="{Binding Gear.Error, Converter={StaticResource NullToCollapsed}}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
