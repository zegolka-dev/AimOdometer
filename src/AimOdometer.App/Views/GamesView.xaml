<UserControl x:Class="AimOdometer.App.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AimOdometer.App.Localization"
             xmlns:c="clr-namespace:AimOdometer.App.Controls"
             x:Name="Root">
  <StackPanel>
    <DockPanel Margin="0,0,0,20">
      <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top"
              Command="{Binding DataContext.OpenShareCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="TopGames">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" Margin="0,0,8,0" />
          <TextBlock Text="{l:T Share.Button}" />
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Games.Title}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Games.Subtitle}" />
      </StackPanel>
    </DockPanel>

    <WrapPanel Margin="0,0,0,20">
      <RadioButton Style="{StaticResource Segment}" GroupName="GRange" Content="{l:T Common.Today}" IsChecked="{Binding Range, Converter={StaticResource EnumEquals}, ConverterParameter=Today}" />
      <RadioButton Style="{StaticResource Segment}" GroupName="GRange" Content="{l:T Common.ThisWeek}" IsChecked="{Binding Range, Converter={StaticResource EnumEquals}, ConverterParameter=Week}" />
      <RadioButton Style="{StaticResource Segment}" GroupName="GRange" Content="{l:T Common.ThisMonth}" IsChecked="{Binding Range, Converter={StaticResource EnumEquals}, ConverterParameter=Month}" />
      <RadioButton Style="{StaticResource Segment}" GroupName="GRange" Content="{l:T Common.AllTime}" IsChecked="{Binding Range, Converter={StaticResource EnumEquals}, ConverterParameter=All}" />
    </WrapPanel>

    <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Games.Empty}" />
    </Border>

    <Grid Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Share donut -->
      <Border Style="{StaticResource Card}" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Games.Share}" />
          <Grid Width="200" Height="200" HorizontalAlignment="Center">
            <c:DonutChart Slices="{Binding Slices}" Thickness="20" />
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
              <TextBlock Text="{Binding GamesShareText}" FontFamily="{StaticResource NumberFont}" FontSize="34" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Games.InGames}" HorizontalAlignment="Center" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Games table -->
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="8,12">
        <StackPanel>
          <Grid Margin="12,0,12,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="110" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="100" />
              <ColumnDefinition Width="56" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Hint}" Text="{l:T Games.ColGame}" />
            <TextBlock Grid.Column="1" Style="{StaticResource Hint}" Text="{l:T Games.ColDistance}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Style="{StaticResource Hint}" Text="{l:T Games.ColTime}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="3" Style="{StaticResource Hint}" Text="{l:T Games.ColPerHour}" HorizontalAlignment="Right" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Games}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border x:Name="Row" CornerRadius="10" Padding="12,8" Background="Transparent">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="110" />
                      <ColumnDefinition Width="100" />
                      <ColumnDefinition Width="100" />
                      <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                      <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource SurfaceElevatedBrush}" Margin="0,0,12,0">
                        <Grid>
                          <Image Source="{Binding Icon}" Width="24" Height="24" />
                          <Ellipse Width="10" Height="10" Fill="{Binding Brush}"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
                        </Grid>
                      </Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="260"
                                   Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBox MaxLength="80" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MinWidth="200"
                                 Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVisibility}}">
                          <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}" />
                          </TextBox.InputBindings>
                        </TextBox>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                          <ProgressBar Style="{StaticResource ShareBar}" Width="90" Value="{Binding Share, Mode=OneWay}" Foreground="{Binding Brush}" />
                          <TextBlock Style="{StaticResource Hint}" Text="{Binding ShareText}" Margin="8,-3,0,0" />
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Distance}" FontFamily="{StaticResource NumberFont}" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="{Binding Time}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Text="{Binding PerHour}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    <Button Grid.Column="4" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            ToolTip="{l:T Games.Actions}" AutomationProperties.Name="{l:T Games.Actions}"
                            Click="OnActionsClick">
                      <TextBlock Style="{StaticResource Icon}" Text="&#xE712;" FontSize="16" />
                      <Button.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{l:T Games.Rename}" Command="{Binding StartRenameCommand}" />
                          <MenuItem Header="{l:T Games.MergeInto}" ItemsSource="{Binding MergeTargets}">
                            <MenuItem.ItemContainerStyle>
                              <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding Name}" />
                                <Setter Property="Command" Value="{Binding DataContext.MergeIntoCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                              </Style>
                            </MenuItem.ItemContainerStyle>
                          </MenuItem>
                          <MenuItem Header="{l:T Games.NotAGame}" Command="{Binding NotAGameCommand}" />
                          <MenuItem Header="{l:T Games.Hide}" Command="{Binding HideCommand}" />
                          <Separator />
                          <MenuItem Header="{l:T Games.ResetDetection}" Command="{Binding ResetDetectionCommand}" />
                        </ContextMenu>
                      </Button.ContextMenu>
                    </Button>
                  </Grid>
                </Border>
                <DataTemplate.Triggers>
                  <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceElevatedBrush}" />
                  </Trigger>
                  <DataTrigger Binding="{Binding IsGame}" Value="False">
                    <Setter TargetName="Row" Property="Opacity" Value="0.8" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Apps that are not games -->
    <Expander Margin="0,16,0,0" Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
      <Expander.Header>
        <TextBlock Text="{l:T Games.OtherApps}" FontSize="15" FontWeight="SemiBold" />
      </Expander.Header>
      <StackPanel Margin="0,8,0,0">
        <TextBlock Style="{StaticResource Hint}" Text="{l:T Games.OtherAppsHint}" Margin="0,0,0,10" FontSize="13" />
        <ItemsControl ItemsSource="{Binding OtherApps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,6">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{Binding Distance}" FontFamily="{StaticResource NumberFont}" Width="90" TextAlignment="Right" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Time}" Foreground="{StaticResource TextSecondaryBrush}" Width="90" TextAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{l:T Games.MarkAsGame}" Command="{Binding MarkAsGameCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource SecondaryButton}" Content="{l:T Games.Hide}" Command="{Binding HideCommand}" />
                  </StackPanel>
                  <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding ExeName}" ToolTip="{Binding ExePath}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Expander>

    <!-- Hidden apps -->
    <Expander Margin="0,8,0,0">
      <Expander.Header>
        <TextBlock Text="{l:T Games.HiddenApps}" FontSize="15" FontWeight="SemiBold" />
      </Expander.Header>
      <StackPanel Margin="0,8,0,0">
        <TextBlock Style="{StaticResource Hint}" Text="{l:T Games.HiddenAppsHint}" Margin="0,0,0,10" FontSize="13" />
        <ItemsControl ItemsSource="{Binding HiddenApps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Style="{StaticResource Card}" Padding="14,8" Margin="0,0,0,6">
                <DockPanel>
                  <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="{l:T Games.ShowAgain}" Command="{Binding RestoreCommand}" />
                  <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0" />
                  <TextBlock Text="{Binding ExeName}" ToolTip="{Binding ExePath}" VerticalAlignment="Center" />
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Expander>
  </StackPanel>
</UserControl>
