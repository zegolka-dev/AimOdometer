<UserControl x:Class="AimOdometer.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AimOdometer.App.Localization"
             xmlns:vm="clr-namespace:AimOdometer.App.ViewModels">
  <Border Style="{StaticResource AccentCard}" Width="820" MinHeight="460" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="36,30"
          Background="{StaticResource SurfaceBrush}">
    <DockPanel>
      <!-- Footer -->
      <DockPanel DockPanel.Dock="Bottom" Margin="0,24,0,0">
        <TextBlock Style="{StaticResource Hint}" Text="{Binding StepText}" VerticalAlignment="Center" FontSize="13" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource LinkButton}" Content="{l:T Onboarding.Skip}" Command="{Binding SkipCommand}" Margin="0,0,16,0" VerticalAlignment="Center" />
          <Button Style="{StaticResource SecondaryButton}" Content="{l:T Common.Back}" Command="{Binding BackCommand}" Margin="0,0,8,0"
                  Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}" />
          <Button Style="{StaticResource PrimaryButton}" Command="{Binding NextCommand}" IsDefault="True">
            <TextBlock>
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Text" Value="{l:T Common.Next}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLast}" Value="True">
                      <Setter Property="Text" Value="{l:T Onboarding.Finish}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Button>
        </StackPanel>
      </DockPanel>

      <Grid>
        <!-- 1. Welcome + tray icon -->
        <StackPanel Visibility="{Binding IsWelcome, Converter={StaticResource BoolToVisibility}}">
          <Image Source="/Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Left" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality" />
          <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Onboarding.WelcomeTitle}" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Onboarding.WelcomeText}" Margin="0,4,0,20" />
          <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="10" Padding="16,12">
            <StackPanel>
              <TextBlock Text="{l:T Onboarding.TrayTitle}" FontWeight="SemiBold" Margin="0,0,0,4" />
              <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Onboarding.TrayText}" FontSize="13" />
              <CheckBox IsChecked="{Binding ShowTrayIcon}" Content="{l:T Settings.ShowTrayIcon}" Margin="0,10,0,0" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- 2. Language -->
        <StackPanel Visibility="{Binding IsLanguage, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Onboarding.LanguageTitle}" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Onboarding.LanguageText}" Margin="0,4,0,20" />
          <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" DisplayMemberPath="NativeName"
                    Width="260" HorizontalAlignment="Left" AutomationProperties.Name="{l:T Settings.Language}" />
        </StackPanel>

        <!-- 3. Units -->
        <StackPanel Visibility="{Binding IsUnits, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Onboarding.UnitsTitle}" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Onboarding.UnitsText}" Margin="0,4,0,20" />
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" GroupName="OnbUnits" Content="{l:T Settings.Metric}" IsChecked="{Binding Metric}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="OnbUnits" Content="{l:T Settings.Imperial}" IsChecked="{Binding Metric, Converter={StaticResource InverseBool}}" />
          </StackPanel>
        </StackPanel>

        <!-- 4. Mouse and DPI -->
        <StackPanel Visibility="{Binding IsMouse, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Onboarding.MouseTitle}" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Onboarding.MouseText}" Margin="0,4,0,16" />
          <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Mice.Devices}" ItemTemplate="{StaticResource DeviceRowTemplate}" />
          </ScrollViewer>
          <TextBlock Style="{StaticResource Hint}" Text="{l:T Onboarding.DpiHint}" FontSize="13" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 5. Autostart -->
        <StackPanel Visibility="{Binding IsAutostart, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Onboarding.AutostartTitle}" />
          <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Onboarding.AutostartText}" Margin="0,4,0,20" />
          <CheckBox IsChecked="{Binding Autostart}" Content="{l:T Settings.Autostart}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:T Onboarding.PrivacyNote}" FontSize="13" Margin="0,24,0,0" />
        </StackPanel>
      </Grid>
    </DockPanel>
  </Border>
</UserControl>
