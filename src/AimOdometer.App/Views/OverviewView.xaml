<UserControl x:Class="AimOdometer.App.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AimOdometer.App.Localization"
             xmlns:c="clr-namespace:AimOdometer.App.Controls">
  <StackPanel>
    <DockPanel Margin="0,0,0,24">
      <Button AutomationProperties.Name="{l:T Share.Button}" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top"
              Command="{Binding DataContext.OpenShareCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Day" AutomationProperties.AutomationId="ShareButton">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" Margin="0,0,8,0" />
          <TextBlock Text="{l:T Share.Button}" />
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Overview.Title}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Overview.Subtitle}" />
      </StackPanel>
    </DockPanel>

    <!-- Autostart is off: after a restart nothing is counted until the app is opened -->
    <Border Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" Margin="0,0,0,16" Padding="20,14"
            Visibility="{Binding AutostartOff, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="AutostartBanner">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{l:T Overview.AutostartEnable}" Command="{Binding EnableAutostartCommand}"
                VerticalAlignment="Center" Margin="16,0,0,0" />
        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="20" Foreground="{StaticResource WarningBrush}" Margin="0,0,14,0" />
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{l:T Overview.AutostartOffTitle}" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="{l:T Overview.AutostartOffText}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Today, live -->
    <Border Style="{StaticResource AccentCard}" Padding="28,22">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Common.Today}" FontSize="14" />
          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock Style="{StaticResource HeroNumber}" c:Motion.CountUp="{Binding TodayNumber}" />
            <TextBlock Text="{Binding TodayUnit}" FontFamily="{StaticResource NumberFont}" FontSize="26"
                       Foreground="{StaticResource AccentTextBrush}" VerticalAlignment="Bottom" Margin="10,0,0,12" />
          </StackPanel>
          <TextBlock Text="{Binding TodayComparison}" FontSize="15" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,0,6"
                     Visibility="{Binding TodayComparison, Converter={StaticResource NullToCollapsed}}" />
          <!-- Streak: the flame grows with the streak (StreakTiers); grey until today counts -->
          <TextBlock Style="{StaticResource Hint}" Text="{Binding StreakText}" FontSize="13"
                     Visibility="{Binding HasStreak, Converter={StaticResource InverseBoolToVisibility}}" />
          <Grid Margin="0,8,0,0" HorizontalAlignment="Left" Background="Transparent" AutomationProperties.AutomationId="Streak"
                Visibility="{Binding HasStreak, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:StreakFlame Days="{Binding StreakDays}" IsLit="{Binding StreakLit}" Width="52" Height="52" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding StreakNumber}" FontFamily="{StaticResource NumberFont}" FontSize="26" FontWeight="SemiBold"
                           Foreground="{Binding StreakBrush}" />
                <TextBlock Text="{l:T Streak.DaysInRow}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="6,0,0,4" />
                <Border CornerRadius="9" Padding="8,1" Margin="10,0,0,4" VerticalAlignment="Bottom" BorderThickness="1"
                        BorderBrush="{Binding StreakBrush}" Background="#14FFFFFF">
                  <TextBlock Text="{Binding StreakTier}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StreakBrush}" />
                </Border>
              </StackPanel>
              <ProgressBar Style="{StaticResource ShareBar}" Value="{Binding StreakProgress, Mode=OneWay}" Width="260" HorizontalAlignment="Left"
                           Foreground="{Binding StreakBrush}" Margin="0,6,0,4" AutomationProperties.Name="{Binding StreakText}" />
              <TextBlock Style="{StaticResource Hint}" Text="{Binding StreakText}" FontSize="12" />
            </StackPanel>
          </Grid>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="200">
          <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Overview.Clicks}" />
          <TextBlock Style="{StaticResource MediumNumber}" Text="{Binding TodayClicks}" Margin="0,0,0,10" />
          <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Overview.ActiveTime}" />
          <TextBlock Style="{StaticResource MediumNumber}" Text="{Binding TodayActive}" Margin="0,0,0,10" />
          <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Overview.PeakSpeed}" />
          <TextBlock Style="{StaticResource MediumNumber}" Text="{Binding TodayPeak}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Periods -->
    <UniformGrid Columns="3" Margin="-6,16,-6,0">
      <Border Style="{StaticResource Card}" Margin="6,0">
        <StackPanel>
          <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Common.ThisWeek}" />
          <TextBlock Style="{StaticResource BigNumber}" c:Motion.CountUp="{Binding Week}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="6,0">
        <StackPanel>
          <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Common.ThisMonth}" />
          <TextBlock Style="{StaticResource BigNumber}" c:Motion.CountUp="{Binding Month}" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Margin="6,0">
        <StackPanel>
          <TextBlock Style="{StaticResource CardLabel}" Text="{l:T Common.AllTime}" />
          <TextBlock Style="{StaticResource BigNumber}" c:Motion.CountUp="{Binding AllTime}" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding AllTimeComparison}" Margin="0,4,0,0" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding MoonText}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Overview.Last14Days}" />
          <c:BarChart Bars="{Binding Bars}" Height="190" />
        </StackPanel>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Overview.TopGamesToday}" />
          <TextBlock Style="{StaticResource Hint}" Text="{l:T Overview.NoGamesToday}" FontSize="13"
                     Visibility="{Binding HasGamesToday, Converter={StaticResource InverseBoolToVisibility}}" />
          <ItemsControl ItemsSource="{Binding TopGames}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,14">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource SurfaceElevatedBrush}" Margin="0,0,12,0">
                    <Image Source="{Binding Icon}" Width="22" Height="22" />
                  </Border>
                  <StackPanel Grid.Column="1">
                    <DockPanel>
                      <TextBlock DockPanel.Dock="Right" Text="{Binding Distance}" FontFamily="{StaticResource NumberFont}" FontSize="14" />
                      <TextBlock Text="{Binding Name}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    </DockPanel>
                    <ProgressBar Style="{StaticResource ShareBar}" Value="{Binding Share, Mode=OneWay}" Foreground="{Binding Brush}" Margin="0,6,0,0" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Grid>
  </StackPanel>
</UserControl>
