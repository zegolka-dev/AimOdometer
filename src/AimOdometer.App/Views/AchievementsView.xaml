<UserControl x:Class="AimOdometer.App.Views.AchievementsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AimOdometer.App.Localization">
  <StackPanel>
    <DockPanel>
      <Button AutomationProperties.Name="{l:T Share.Button}" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" VerticalAlignment="Top"
              Command="{Binding DataContext.OpenShareCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Achievement">
        <StackPanel Orientation="Horizontal">
          <TextBlock Style="{StaticResource Icon}" Text="&#xE72D;" Margin="0,0,8,0" />
          <TextBlock Text="{l:T Share.Button}" />
        </StackPanel>
      </Button>
      <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Ach.Title}" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Ach.Subtitle}" />
      </StackPanel>
    </DockPanel>

    <Border Style="{StaticResource AccentCard}" Margin="0,20,0,16">
      <StackPanel>
        <TextBlock Text="{Binding Summary}" FontFamily="{StaticResource NumberFont}" FontSize="22" />
        <ProgressBar Style="{StaticResource ShareBar}" Height="8" Value="{Binding UnlockedFraction, Mode=OneWay}" Margin="0,10,0,0" />
      </StackPanel>
    </Border>

    <ItemsControl ItemsSource="{Binding Items}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border x:Name="Card" Style="{StaticResource Card}" Margin="0,0,12,12" Padding="16,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="Badge" Width="52" Height="52" CornerRadius="26" Background="{StaticResource SurfaceElevatedBrush}" Margin="0,0,14,0" VerticalAlignment="Top">
                <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Description}" Style="{StaticResource Hint}" FontSize="13" Margin="0,2,0,8" />
                <ProgressBar x:Name="Bar" Style="{StaticResource ShareBar}" Value="{Binding Fraction, Mode=OneWay}" Foreground="{StaticResource BarBrush}" />
                <DockPanel Margin="0,6,0,0">
                  <TextBlock DockPanel.Dock="Right" Text="{Binding UnlockedText}" Style="{StaticResource Hint}" />
                  <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" FontFamily="{StaticResource NumberFont}" />
                </DockPanel>
              </StackPanel>
            </Grid>
          </Border>
          <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsUnlocked}" Value="True">
              <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
              <Setter TargetName="Badge" Property="Background" Value="{StaticResource AccentSoftBrush}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource AccentTextBrush}" />
              <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource AccentBrush}" />
            </DataTrigger>
            <!-- Shame: inflated distance, in red. -->
            <DataTrigger Binding="{Binding IsShame}" Value="True">
              <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource DangerBrush}" />
              <Setter TargetName="Badge" Property="Background" Value="{StaticResource DangerSoftBrush}" />
              <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource DangerBrush}" />
              <Setter TargetName="Bar" Property="Foreground" Value="{StaticResource DangerBrush}" />
            </DataTrigger>
          </DataTemplate.Triggers>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
