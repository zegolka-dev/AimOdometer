<UserControl x:Class="AimOdometer.App.Views.MapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:AimOdometer.App.Localization">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Margin="0,0,0,20">
      <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Map.Title}" />
      <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T Map.Subtitle}" />
    </StackPanel>

    <!-- Before the first use: say which services the map talks to, load nothing until allowed. -->
    <Border Grid.Row="1" Style="{StaticResource AccentCard}" MaxWidth="760" HorizontalAlignment="Left"
            Visibility="{Binding IsEnabled, Converter={StaticResource InverseBoolToVisibility}}">
      <StackPanel>
        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Map.ConsentTitle}" />
        <TextBlock Text="{l:T Map.ConsentText}" TextWrapping="Wrap" FontSize="14" LineHeight="21" Foreground="{StaticResource TextSecondaryBrush}" />
        <Button Style="{StaticResource PrimaryButton}" Content="{l:T Map.Enable}" Command="{Binding EnableCommand}"
                HorizontalAlignment="Left" Margin="0,18,0,0" AutomationProperties.AutomationId="MapEnable" />
      </StackPanel>
    </Border>

    <!-- Journey and caption -->
    <Grid Grid.Row="1" Margin="0,0,0,16" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding SearchHint}"
                   AutomationProperties.AutomationId="MapSearch">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <!-- Placeholder -->
          <TextBlock Text="{Binding SearchHint}" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="12,0,0,0"
                     VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"
                     Visibility="{Binding Query, Converter={StaticResource NullToCollapsed}, ConverterParameter=invert}" />
          <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{l:T Map.Search}" Command="{Binding SearchCommand}" Margin="8,0,0,0" AutomationProperties.AutomationId="MapFind" />
        </Grid>

        <TextBlock Style="{StaticResource Hint}" Text="{Binding SearchMessage}" Margin="2,8,0,0" TextWrapping="Wrap"
                   Visibility="{Binding SearchMessage, Converter={StaticResource NullToCollapsed}}" />

        <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,6,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Left" Margin="0,4,0,0" Padding="12,6"
                      Command="{Binding DataContext.AddPlaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding Details}">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Details}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The chain of places -->
        <WrapPanel Margin="0,12,0,0" Visibility="{Binding HasPlaces, Converter={StaticResource BoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding Places}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" Margin="0,2,6,2">
                  <TextBlock x:Name="Arrow" Text="→" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                  <Border Background="{StaticResource SurfaceElevatedBrush}" CornerRadius="8" Padding="10,4" ToolTip="{Binding DisplayName}">
                    <TextBlock Text="{Binding Name}" FontSize="13" />
                  </Border>
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                    <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- Random destination while only the start is chosen -->
          <StackPanel Orientation="Horizontal" Margin="0,2,6,2" Visibility="{Binding AutoTargetName, Converter={StaticResource NullToCollapsed}}">
            <TextBlock Text="→" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
            <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,3" ToolTip="{l:T Map.AutoTarget}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B1;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{StaticResource AccentTextBrush}" />
                <TextBlock Text="{Binding AutoTargetName}" FontSize="13" Foreground="{StaticResource AccentTextBrush}" />
              </StackPanel>
            </Border>
          </StackPanel>
          <Button Style="{StaticResource LinkButton}" Content="{l:T Map.Shuffle}" Command="{Binding ShuffleCommand}" Margin="6,0,0,0"
                  AutomationProperties.AutomationId="MapShuffle" Visibility="{Binding AutoTargetName, Converter={StaticResource NullToCollapsed}}" />
          <Button Style="{StaticResource LinkButton}" Content="{l:T Map.RemoveLast}" Command="{Binding RemoveLastCommand}" Margin="6,0,0,0" />
          <Button Style="{StaticResource LinkButton}" Content="{l:T Map.Clear}" Command="{Binding ClearCommand}" Margin="6,0,0,0" />
        </WrapPanel>
      </StackPanel>

      <Border Grid.Column="2" Style="{StaticResource AccentCard}" VerticalAlignment="Top">
        <StackPanel>
          <WrapPanel Margin="0,0,0,14">
            <RadioButton Style="{StaticResource Segment}" GroupName="MapPeriod" Content="{l:T Map.Period.Today}" IsChecked="{Binding Period, Converter={StaticResource EnumEquals}, ConverterParameter=Today}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="MapPeriod" Content="{l:T Map.Period.Week}" IsChecked="{Binding Period, Converter={StaticResource EnumEquals}, ConverterParameter=Week}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="MapPeriod" Content="{l:T Map.Period.Month}" IsChecked="{Binding Period, Converter={StaticResource EnumEquals}, ConverterParameter=Month}" />
            <RadioButton Style="{StaticResource Segment}" GroupName="MapPeriod" Content="{l:T Map.Period.AllTime}" IsChecked="{Binding Period, Converter={StaticResource EnumEquals}, ConverterParameter=AllTime}" />
          </WrapPanel>
          <TextBlock Text="{Binding CaptionLead}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding CaptionRoute}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource AccentTextBrush}" TextWrapping="Wrap" Margin="0,2,0,0"
                     Visibility="{Binding CaptionRoute, Converter={StaticResource NullToCollapsed}}" />
          <TextBlock Text="{Binding CaptionDetails}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0"
                     Visibility="{Binding CaptionDetails, Converter={StaticResource NullToCollapsed}}" />
          <TextBlock Style="{StaticResource Hint}" Text="{Binding Notice}" TextWrapping="Wrap" Margin="0,10,0,0"
                     Visibility="{Binding Notice, Converter={StaticResource NullToCollapsed}}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- The map: a WebView2 created in code only while this page is shown. -->
    <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
            MinHeight="260" Visibility="{Binding IsEnabled, Converter={StaticResource BoolToVisibility}}">
      <Grid>
        <Decorator x:Name="MapHost" />
        <TextBlock Text="{Binding MapError}" TextWrapping="Wrap" FontSize="14" Margin="24" MaxWidth="560"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"
                   Visibility="{Binding MapError, Converter={StaticResource NullToCollapsed}}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
