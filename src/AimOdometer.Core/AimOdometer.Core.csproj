<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AimOdometer.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Native SQLite build only (e_sqlite3.dll); the managed wrapper is our own (NativeAOT-friendly). -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\data\games.json" LogicalName="AimOdometer.Data.games.json" />
    <EmbeddedResource Include="..\..\data\comparisons.json" LogicalName="AimOdometer.Data.comparisons.json" />
    <EmbeddedResource Include="..\..\data\achievements.json" LogicalName="AimOdometer.Data.achievements.json" />
    <EmbeddedResource Include="..\..\data\services.json" LogicalName="AimOdometer.Data.services.json" />
    <EmbeddedResource Include="..\..\data\cities.json" LogicalName="AimOdometer.Data.cities.json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AimOdometer.Core.Tests" />
  </ItemGroup>
</Project>
