# Copy to .env (never commit .env). Values are only needed for later phases.

# Phase 7 — Supabase (public values, safe for the client)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Server-side secrets: set them with `supabase secrets set`, NEVER put real values here.
# STEAM_WEB_API_KEY=
